{
  "name": "vercel-skills-compatibility",
  "work_type": "feature",
  "status": "in-progress",
  "created": "2026-10-05",
  "description": "Make agntc a like-for-like replacement for Vercel's skills CLI — anything built for their skills library installs through agntc (same source formats and flags, unattended installs, a pre-install summary) — without breaking agntc's plugin bundling, and fixing partially-done paths along the way (e.g. update's re-add advice dropping --plugin).",
  "phases": {
    "research": {
      "items": {
        "vercel-skills-compatibility": {
          "status": "completed",
          "threads": {
            "vercel-cli-surface": {
              "question": "What is the full, current surface of Vercel's skills CLI — commands, add flags, source-string grammar (what @, # and subpaths select, and matched against what), agent targeting, non-interactive behaviour, and install semantics?",
              "status": "learned",
              "origin": "seed",
              "parent": null
            },
            "vercel-capability-gaps": {
              "question": "Of Vercel's capabilities beyond project install from git — global scope, find/search, use, well-known endpoints, packs, direct URLs, Notion — which does like-for-like need, and would any make this several pieces?",
              "status": "open",
              "origin": "seed",
              "parent": "vercel-cli-surface"
            },
            "compatibility-matrix": {
              "question": "For each Vercel flag, source format and behaviour, does agntc already match it — and where it doesn't, what are the options: adapt agntc's rules, change them, or support both?",
              "status": "open",
              "origin": "seed",
              "parent": null
            },
            "plugin-bundling-coexistence": {
              "question": "Where do Vercel's selection, discovery and defaults press on agntc's guarantees — picking a skill out of a unit, the validity gate, the author's agent restriction, unattended defaults — and what are the options at each?",
              "status": "open",
              "origin": "seed",
              "parent": "compatibility-matrix"
            },
            "directory-install-coverage": {
              "question": "Do popular directory repos install cleanly through agntc today, and where do they fail?",
              "status": "learned",
              "origin": "seed",
              "parent": null
            },
            "unattended-install": {
              "question": "What does an unattended add need — agent preselection against a unit's ceiling, what --yes answers at each prompt, conflict resolution, collection member selection, interaction with auto-select, and error behaviour when a flagged agent is outside the ceiling?",
              "status": "open",
              "origin": "seed",
              "parent": null
            },
            "unattended-hook-scripts": {
              "question": "Unattended installs remove the last human look before hook scripts land — what does that change for agntc, given Vercel installs no hooks and its only gate is a proceed prompt that -y and agent detection skip?",
              "status": "open",
              "origin": "seed",
              "parent": "unattended-install"
            },
            "pre-install-summary": {
              "question": "What should the post-clone summary show — source, detected type, member count, unit names — and is a display-only SKILL.md description read worth adding?",
              "status": "open",
              "origin": "seed",
              "parent": null
            },
            "frontmatter-validity-stance": {
              "question": "Vercel skips, with a warning, any skill lacking a string name and description, failing only when none is valid — what are the options for agntc's position on skills Vercel would skip?",
              "status": "open",
              "origin": "seed",
              "parent": null
            },
            "plugin-readd-defect": {
              "question": "Which of agntc's printed re-add and upgrade commands fail to reproduce the install they advise on — dropping --plugin, or printing member keys the parser refuses — and what happens when they're followed?",
              "status": "learned",
              "origin": "seed",
              "parent": null
            },
            "at-sign-meaning": {
              "question": "What should @ mean in an agntc source string, given Vercel uses it to select a skill and agntc uses it for a version or branch?",
              "status": "open",
              "origin": "user",
              "parent": "compatibility-matrix"
            },
            "agent-preview": {
              "question": "When an agent drives agntc, how does it learn what a repo contains before choosing — does it need a look-without-installing mode, or is the pre-install summary enough?",
              "status": "open",
              "origin": "conversation",
              "parent": "unattended-install"
            },
            "name-folder-divergence": {
              "question": "How often does a skill's folder name differ from its frontmatter name across skills.sh repos — and does skills.sh ever print a --skill value that isn't the frontmatter name?",
              "status": "open",
              "origin": "deep-dive-001",
              "parent": "vercel-cli-surface"
            },
            "install-line-forms": {
              "question": "Which npx skills add forms appear in public READMEs, and how often — @skill, --skill, #ref, /subpath, tree URLs, -g, -a, -y, --all, --copy — i.e. which forms does paste-and-go have to cover?",
              "status": "open",
              "origin": "deep-dive-001",
              "parent": "vercel-cli-surface"
            },
            "agent-detection": {
              "question": "How does Vercel's CLI detect that it is running inside an AI agent such as Claude Code or Codex, and how reliable is that signal?",
              "status": "open",
              "origin": "deep-dive-001",
              "parent": "vercel-cli-surface"
            },
            "skill-identity": {
              "question": "Vercel selects, names and locks skills by frontmatter name; agntc by folder name — what are the options for matching a pasted --skill or @skill, and for the installed directory's name?",
              "status": "open",
              "origin": "conversation",
              "parent": "compatibility-matrix"
            },
            "vercel-installed-coexistence": {
              "question": "When a project already has skills installed by Vercel's CLI (.agents/skills, symlinks, skills-lock.json), what happens when agntc installs or manages the same skills?",
              "status": "open",
              "origin": "conversation",
              "parent": "compatibility-matrix"
            },
            "skill-local-agents-dir": {
              "question": "Skills carry their own agents/ folders — OpenAI's agents/openai.yaml and skill-local helper prompts — which agntc reads as a plugin, dropping the SKILL.md; what are the options for telling a skill's own agents/ from a plugin's?",
              "status": "open",
              "origin": "conversation",
              "parent": "directory-install-coverage"
            },
            "category-depth": {
              "question": "Directory repos nest skills in category folders (skills/<category>/<skill>) that agntc's one-level collection read misses — what are the options for how deep agntc looks?",
              "status": "open",
              "origin": "conversation",
              "parent": "directory-install-coverage"
            },
            "tag-vs-head": {
              "question": "agntc's bare add installs the latest semver tag where Vercel installs the default branch — for a pasted line, which install counts as the same?",
              "status": "open",
              "origin": "conversation",
              "parent": "directory-install-coverage"
            }
          }
        }
      }
    },
