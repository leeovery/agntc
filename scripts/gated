#!/usr/bin/env bash
#
# The release's gate, mint's pre_tag: passes the commit at HEAD when
# scripts/gate has recorded its tree as passing every gate, or the tree of a
# commit before it from which only inert paths have changed: the README,
# CLAUDE.md, CHANGELOG.md and .mint.toml at the root, and design/, art/,
# demo/, .workflows/, .claude/, .tick/ and .agntc/, which no gate reads
# (tsc reads src/ and tests/, tsup bundles what src/cli.ts imports, and
# vitest runs only tests/). That holds only while src/ and tests/ never read,
# import or link to an inert path; scripts/declared-imports.mjs refuses an
# import from outside them, a committed link outside the inert paths and a
# package.json mapping onto a local path, and a read is the reviewer's to
# catch. Anything else is read by a gate: package.json and the lockfile
# among them, and .github/, as CI runs publish.yml's steps on the tag before
# it publishes. The walk back, along first parents, stops at a commit that changes
# anything else, at a merge, at the first commit (or a shallow clone's
# boundary), or after 50 commits, and then scripts/gate runs every gate on
# HEAD, which passes only once its tree is recorded.
# Once this passes, mint makes two commits and tags the second: first
# whatever the checkout then holds (`git add -A`), as `chore(release):
# pre-tag artifacts for vX`; then, once it has written the notes and held
# its review, `Release vX`, of CHANGELOG.md alone. So a checkout holding
# anything outside the inert paths that HEAD doesn't, staged or not,
# untracked files included, however git is told to see it (a file it's told
# to assume unchanged or skip, a copy of scripts/gate or scripts/gated
# unlike HEAD's), is refused, before anything runs and again as it passes;
# and it passes only while HEAD is still the commit it judged. mint shows
# only this script's exit, so run it directly to see why it failed.
set -euo pipefail
# A hook's git environment (GIT_DIR, GIT_INDEX_FILE) would turn the checks on
# whichever repo and index it names.
# shellcheck disable=SC2046
unset $(git rev-parse --local-env-vars)

repo=$(cd "$(dirname "$0")/.." && pwd -P)
cd "$repo"

record=$(git rev-parse --path-format=absolute --git-common-dir)/agntc/gated
bound=50
judged_commit=$(git rev-parse HEAD)
judged=$(git rev-parse "$judged_commit^{tree}")

# inert reports whether the path given is one no gate reads. git quotes a
# path with unusual characters, which then matches none of these.
inert() {
	case $1 in
	README.md | CLAUDE.md | CHANGELOG.md | .mint.toml | design/* | art/* | demo/* | .workflows/* | .claude/* | .tick/* | .agntc/*) return 0 ;;
	esac
	return 1
}

# all_inert reports whether every path listed, one a line, is inert.
all_inert() {
	local path
	while IFS= read -r path; do
		[ -z "$path" ] || inert "$path" || return 1
	done <<<"$1"
}

short() {
	git rev-parse --short "$1"
}

refuse() {
	echo "gated: $1" >&2
	exit 1
}

# unchanged refuses a checkout holding, outside the inert paths, anything the
# commit judged doesn't, as mint would release it; `when` says when it was
# found.
unchanged() {
	local when=$1 changed untracked passed_over script
	changed=$(git diff --name-only --no-renames "$judged_commit")
	untracked=$(git ls-files --others --exclude-standard)
	if ! all_inert "$changed" || ! all_inert "$untracked"; then
		refuse "the checkout has changes outside the inert paths $when, and mint would release them: commit them or set them aside"
	fi
	passed_over=$(git ls-files -v | sed -n 's/^[a-zS] //p')
	if ! all_inert "$passed_over"; then
		refuse "git is told to pass over $(head -1 <<<"$passed_over") $when (assume unchanged or skip), so a change there would be released unseen: clear the flag"
	fi
	for script in scripts/gate scripts/gated; do
		if [ "$(git hash-object --no-filters "$script")" != "$(git rev-parse "$judged_commit:$script")" ]; then
			refuse "$script isn't HEAD's $when, and a release is of HEAD: commit it or set the change aside"
		fi
	done
}

# pass ends the run passing, once the checkout still holds only the commit
# judged.
pass() {
	local now
	unchanged "as it passed"
	now=$(git rev-parse 'HEAD^{tree}')
	if [ "$now" != "$judged" ]; then
		refuse "HEAD moved to tree $(short "$now") while tree $(short "$judged") was judged, so the commit mint would tag isn't the one checked"
	fi
	exit 0
}

# full runs every gate on HEAD, after saying why, and passes only once that
# has recorded the tree judged.
full() {
	echo "gated: $1: running the gates"
	"$repo/scripts/gate"
	if ! grep -qxF "$judged" "$record" 2>/dev/null; then
		refuse "scripts/gate passed but recorded nothing for tree $(short "$judged"), so HEAD isn't gated"
	fi
	pass
}

unchanged "before anything ran"

known=
if [ -f "$record" ]; then
	known=$'\n'$(<"$record")$'\n'
fi

# The walk: from HEAD back along first parents, a commit a line, each with
# its tree and parents. Then each commit's changed paths, under a tab and its
# hash, read in one call for the whole walk, as a call a commit took two
# seconds over 50.
walk=$(git rev-list --first-parent --max-count=$((bound + 1)) --no-commit-header --format='%H %T %P' "$judged_commit")
diffs=$(cut -d ' ' -f 1 <<<"$walk" | git diff-tree --stdin -r --name-only --no-renames --format='%x09%H')

# code is the first commit along the walk that changes a path not inert.
code=
commit=
while IFS= read -r line; do
	case $line in
	$'\t'*) commit=${line#$'\t'} ;;
	'') ;;
	*)
		if ! inert "$line"; then
			code=$commit
			break
		fi
		;;
	esac
done <<<"$diffs"

head=
while read -r commit tree parent others; do
	if [[ $known == *$'\n'"$tree"$'\n'* ]]; then
		if [ -z "$head" ]; then
			echo "gated: gates passed on tree $(short "$tree") ✓"
		else
			echo "gated: gates passed on tree $(short "$tree"), at $(short "$commit"), and nothing since changes code ✓"
		fi
		pass
	fi
	head=${head:-$commit}
	if [ -z "$parent" ]; then
		full "no record of the gates on $(short "$commit") (the first commit, or a shallow clone's boundary)"
	elif [ -n "$others" ]; then
		full "no record of the gates on $(short "$commit") (a merge)"
	elif [ "$commit" = "$code" ]; then
		full "no record of the gates on $(short "$commit") (it changes code)"
	fi
done <<<"$walk"
full "no record of the gates within $bound commits of $(short "$head")"
