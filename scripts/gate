#!/usr/bin/env bash
#
# Runs every gate on the commit at HEAD, in a fresh checkout of it outside
# the repo, stopping at the first that fails: npm ci, then
# scripts/declared-imports.mjs, npm run typecheck, npm run build and npm test
# in the CI job's order, the tests refusing a committed .only as CI does.
# Changes not committed are no part of it, whatever git is told to show or
# pass over. The checkout is a worktree of its own in a new folder under
# TMPDIR, removed however the run ends; a node_modules in any folder above it
# stops the run before anything is installed, as node, tsc and npm run would
# find packages there that package-lock.json doesn't install, which is how a
# worktree under the primary checkout passes on the primary's packages.
# When every gate passes, HEAD's tree is recorded in the git common
# directory, at agntc/gated, one hash a line, shared by every worktree.
# scripts/gated, the release's gate, reads it to pass a tree already gated.
set -euo pipefail

repo=$(cd "$(dirname "$0")/.." && pwd -P)

record=$(git -C "$repo" rev-parse --path-format=absolute --git-common-dir)/agntc/gated
commit=$(git -C "$repo" rev-parse HEAD)
tree=$(git -C "$repo" rev-parse 'HEAD^{tree}')
short=$(git -C "$repo" rev-parse --short HEAD)

tmp=${TMPDIR:-/tmp}
scratch=$(mktemp -d "${tmp%/}/agntc-gate.XXXXXX")
checkout=$scratch/agntc

# cleanup removes the checkout and its folder, and git's note of it.
cleanup() {
	cd "$repo"
	git worktree remove --force "$checkout" >/dev/null 2>&1 || true
	rm -rf "$scratch"
	git worktree prune
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# run runs a gate, and on its failure says so and exits with its status.
run() {
	local status=0
	echo "gate: $*"
	"$@" || status=$?
	if [ "$status" != 0 ]; then
		echo "gate: $* failed, so nothing is recorded" >&2
		exit "$status"
	fi
}

# above names the first node_modules in the folder given or one above it,
# its real path and the path it was reached by both walked.
above() {
	local dir
	for dir in "$1" "$(cd "$1" && pwd -P)"; do
		while :; do
			if [ -e "$dir/node_modules" ]; then
				echo "$dir/node_modules"
				return
			fi
			[ "$dir" != / ] || break
			dir=$(dirname "$dir")
		done
	done
}

found=$(above "$scratch")
if [ -n "$found" ]; then
	echo "gate: $found lies above the checkout the gates would run in, $checkout, and node and tsc would find packages there that package-lock.json doesn't install, so nothing is run or recorded: set TMPDIR to a folder with no node_modules above it" >&2
	exit 1
fi

echo "gate: checking HEAD $short in a fresh checkout at $checkout; changes not committed are no part of it"
git -C "$repo" worktree add --quiet --detach "$checkout" "$commit"
cd "$checkout"
unset NODE_PATH

run npm ci
run node scripts/declared-imports.mjs
run npm run typecheck
run npm run build
run npm test -- --allowOnly=false

mkdir -p "$(dirname "$record")"
if ! grep -qxF "$tree" "$record" 2>/dev/null; then
	printf '%s\n' "$tree" >>"$record"
fi
echo "gate: every gate passed on HEAD $short, tree $(git rev-parse --short "$tree"), recorded"
