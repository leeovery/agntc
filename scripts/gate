#!/usr/bin/env bash
#
# Runs every gate on the commit at HEAD, in a fresh checkout of it outside
# the repo, stopping at the first that fails: npm ci, then
# scripts/declared-imports.mjs, npm run typecheck, npm run build and npm test
# in the CI job's order, the tests refusing a committed .only as CI does.
# Changes not committed are no part of it, this script's own included,
# whatever git is told to show or pass over: whichever copy is called reads
# HEAD and makes the checkout, a worktree of its own in a new folder under
# TMPDIR, and hands the rest to the checkout's copy, HEAD's, which runs the
# steps and removes the checkout however the run ends.
# The steps run on the checkout alone. A node_modules in any folder above it
# stops the run before anything is installed, as node, tsc and npm run would
# find packages there that package-lock.json doesn't install, which is how a
# worktree under the primary checkout passes on the primary's packages; so
# does a node whose major version isn't the one HEAD's .nvmrc names. The
# steps see no npm config but HEAD's own, no NODE_PATH or NODE_OPTIONS, no
# node_modules/.bin on PATH, and a TMPDIR inside the checkout's folder.
# When every step passes, the tree of the commit checked is recorded in the
# git common directory, at agntc/gated, one hash a line, shared by every
# worktree. scripts/gated, the release's gate, reads it to pass a tree
# already gated.
set -euo pipefail

# forget removes git's note of the worktree at the folder given, which
# `git worktree remove` leaves when an add was stopped midway. Unlike
# `git worktree prune` it touches no other worktree, so none whose folder is
# away for a while (an unmounted volume) loses its entry.
forget() {
	local entry
	for entry in "$common"/worktrees/*; do
		if [ -f "$entry/gitdir" ] && [ "$(<"$entry/gitdir")" = "$1/.git" ]; then
			rm -rf "$entry"
		fi
	done
}

# forget_stale removes git's note of every checkout a gate made whose folder
# is gone, as a gate killed outright leaves once TMPDIR is cleaned. One whose
# folder is there may be another gate's, still running, so it stays.
forget_stale() {
	local entry gitdir
	for entry in "$common"/worktrees/*; do
		[ -f "$entry/gitdir" ] || continue
		gitdir=$(<"$entry/gitdir")
		case $gitdir in
		*/agntc-gate.*/agntc/.git)
			if [ ! -e "$(dirname "$gitdir")" ] && [ ! -e "$entry/locked" ]; then
				rm -rf "$entry"
			fi
			;;
		esac
	done
}

# cleanup removes the checkout, its folder and git's note of it.
cleanup() {
	cd /
	git -C "$repo" worktree remove --force "$checkout" >/dev/null 2>&1 || true
	rm -rf "$scratch"
	forget "$checkout"
}

# stopped says the run was stopped and ends it with the signal's status.
stopped() {
	echo "gate: stopped by SIG$1, so nothing is recorded" >&2
	exit "$2"
}

if [ "${1:-}" != --in-checkout ]; then
	repo=$(cd "$(dirname "$0")/.." && pwd -P)
	common=$(git -C "$repo" rev-parse --path-format=absolute --git-common-dir)
	commit=$(git -C "$repo" rev-parse HEAD)
	tmp=${TMPDIR:-/tmp}
	scratch=$(cd "$(mktemp -d "${tmp%/}/agntc-gate.XXXXXX")" && pwd -P)
	checkout=$scratch/agntc

	trap cleanup EXIT
	trap 'stopped INT 130' INT
	trap 'stopped TERM 143' TERM
	forget_stale
	git -C "$repo" worktree add --quiet --detach "$checkout" "$commit"
	trap - EXIT INT TERM
	exec "$checkout/scripts/gate" --in-checkout "$repo" "$commit" "$scratch"
fi

repo=$2
commit=$3
scratch=$4
checkout=$scratch/agntc
common=$(git -C "$repo" rev-parse --path-format=absolute --git-common-dir)
record=$common/agntc/gated
short=$(git -C "$repo" rev-parse --short "$commit")

trap cleanup EXIT
trap 'stopped INT 130' INT
trap 'stopped TERM 143' TERM

# refuse says why nothing is run and ends the run.
refuse() {
	echo "gate: $1, so nothing is run or recorded" >&2
	exit 1
}

# run runs a step, and on its failure says so and exits with its status.
run() {
	local status=0
	echo "gate: $*"
	"$@" || status=$?
	if [ "$status" != 0 ]; then
		echo "gate: $* failed or was stopped, so nothing is recorded" >&2
		exit "$status"
	fi
}

# above names the first node_modules in the folder given or one above it,
# its real path and the path it was reached by both walked.
above() {
	local dir
	for dir in "$1" "$(cd "$1" && pwd -P)"; do
		while :; do
			if [ -e "$dir/node_modules" ]; then
				echo "$dir/node_modules"
				return
			fi
			[ "$dir" != / ] || break
			dir=$(dirname "$dir")
		done
	done
}

# Called with TMPDIR as given, as the folder made from it is a real path.
found=$(above "${TMPDIR:-/tmp}")
if [ -n "$found" ]; then
	refuse "$found lies above the checkout the gates would run in, $checkout, and node and tsc would find packages there that package-lock.json doesn't install: set TMPDIR to a folder with no node_modules above it"
fi

cd "$checkout"

unset NODE_PATH NODE_OPTIONS
shopt -s nocasematch
for name in $(compgen -e); do
	case $name in
	npm_config_*) unset "$name" ;;
	esac
done
shopt -u nocasematch
# Two empty files, as npm refuses one file read as both.
: >"$scratch/user.npmrc"
: >"$scratch/global.npmrc"
export NPM_CONFIG_USERCONFIG=$scratch/user.npmrc NPM_CONFIG_GLOBALCONFIG=$scratch/global.npmrc
kept=
IFS=: read -ra entries <<<"$PATH"
for entry in "${entries[@]}"; do
	case $entry in
	node_modules/.bin | node_modules/.bin/ | */node_modules/.bin | */node_modules/.bin/) ;;
	*) kept=${kept:+$kept:}$entry ;;
	esac
done
export PATH=$kept
mkdir "$scratch/tmp"
export TMPDIR=$scratch/tmp

[ -f .nvmrc ] || refuse "HEAD $short has no .nvmrc to name the node it runs on"
wanted=$(tr -d '[:space:]v' <.nvmrc)
wanted=${wanted%%.*}
running=$(node --version)
running=${running#v}
running=${running%%.*}
if [ "$running" != "$wanted" ]; then
	refuse "node $running is on PATH, but HEAD's .nvmrc names node $wanted"
fi

echo "gate: checking HEAD $short in a fresh checkout at $checkout; changes not committed are no part of it"
run npm ci
run node scripts/declared-imports.mjs
run npm run typecheck
run npm run build
run npm test -- --allowOnly=false

tree=$(git -C "$repo" rev-parse "$commit^{tree}")
mkdir -p "$(dirname "$record")"
if ! grep -qxF "$tree" "$record" 2>/dev/null; then
	printf '%s\n' "$tree" >>"$record"
fi
echo "gate: every gate passed on HEAD $short, tree $(git -C "$repo" rev-parse --short "$tree"), recorded"
