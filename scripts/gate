#!/usr/bin/env bash
#
# Runs every gate, stopping at the first that fails: scripts/declared-imports.mjs,
# then npm run typecheck, npm run build and npm test in the CI job's order,
# on node_modules as npm ci installs them from package-lock.json. npm ci
# runs first unless node_modules carries the stamp this script left after
# its own npm ci on the same package.json, package-lock.json, node and
# platform, with npm's record of node_modules (node_modules/.package-lock.json)
# unchanged since and nothing in node_modules newer than the stamp but the
# caches vitest keeps there, so any install npm has made since, or any edit
# by hand, forces a clean one again.
# When every gate passes on a checkout that was clean as they began and
# still is, the tree they passed on is recorded in the git common directory,
# at agntc/gated, one hash a line, shared by every worktree. Clean means
# git sees no change, submodules and every untracked file included, marks
# no file to skip or assume unchanged, and ignores nothing in src/ or
# tests/. scripts/gated, the release's gate, reads it to pass a tree
# already gated. A checkout with changes runs the gates all the same, but
# records nothing: its tree isn't the one they checked.
set -euo pipefail

repo=$(cd "$(dirname "$0")/.." && pwd -P)
cd "$repo"

record=$(git rev-parse --path-format=absolute --git-common-dir)/agntc/gated
stamp=node_modules/.agntc-gate

# clean reports whether the checkout holds nothing a fresh clone of its
# tree wouldn't: no change git sees, however it is configured, no file it
# is told to pass over, and nothing ignored where the gates read.
clean() {
	[ -z "$(git status --porcelain --untracked-files=all --ignore-submodules=none)" ] &&
		[ -z "$(git ls-files -v | grep '^[a-zS] ')" ] &&
		[ -z "$(git ls-files --others --ignored --exclude-standard -- src tests)" ]
}

# run runs a gate, and on its failure says so and exits with its status.
run() {
	local status=0
	echo "gate: $*"
	"$@" || status=$?
	if [ "$status" != 0 ]; then
		echo "gate: $* failed, so nothing is recorded" >&2
		exit "$status"
	fi
}

# installed describes what node_modules was installed from and as: the
# manifests, npm's record of the install, node and the platform. It fails
# when node_modules holds no install npm recorded.
installed() {
	git hash-object package.json package-lock.json node_modules/.package-lock.json 2>/dev/null &&
		node --version &&
		uname -sm
}

# untouched reports whether nothing in node_modules is newer than the stamp,
# vitest's caches aside, as the gates write those themselves.
untouched() {
	[ -z "$(find node_modules -mindepth 1 \
		\( -path node_modules/.vite -o -path node_modules/.vite-temp \) -prune \
		-o -newer "$stamp" -print)" ]
}

tree=$(git rev-parse 'HEAD^{tree}')
began_clean=true
clean || began_clean=false

if [ -f "$stamp" ] && [ "$(installed)" = "$(<"$stamp")" ] && untouched; then
	echo "gate: node_modules is as npm ci installed it from package-lock.json"
else
	rm -f "$stamp"
	run npm ci
	installed >"$stamp"
fi
run node scripts/declared-imports.mjs
run npm run typecheck
run npm run build
run npm test

short=$(git rev-parse --short "$tree")
if [ "$began_clean" = false ]; then
	echo "gate: every gate passed, but nothing is recorded: the checkout had changes as they began"
elif ! clean || [ "$(git rev-parse 'HEAD^{tree}')" != "$tree" ]; then
	echo "gate: every gate passed, but nothing is recorded: the checkout changed while they ran"
else
	mkdir -p "$(dirname "$record")"
	if ! grep -qxF "$tree" "$record" 2>/dev/null; then
		printf '%s\n' "$tree" >>"$record"
	fi
	echo "gate: every gate passed on tree $short, recorded"
fi
